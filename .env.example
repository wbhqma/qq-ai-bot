# 这是公开配置模板；AppID、密钥和群标识始终留空，真实值仅写入本机 .env。
BOT_NAME=哦鲸鲸
QQ_APP_ID=
QQ_APP_SECRET=
# deepseek / compatible（千问、腾讯 TokenHub 等）/ openai / anthropic / gemini / ollama
LLM_PROVIDER=deepseek
# DeepSeek 模式下，地址和模型留空使用默认值；其他服务的模型名称必填。
# compatible 还必须填写 API 地址；其他接入方式提供默认地址。
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_MAX_TOKENS=2048
# 可选模型专用参数，例如 {"enable_thinking":false}。必须为 JSON 对象。
LLM_EXTRA_BODY={}
# 仅 compatible 使用；部分推理模型要求 max_completion_tokens。
LLM_TOKEN_PARAM=max_tokens
HISTORY_TURNS=6
COOLDOWN_SECONDS=3
# 可选：限制允许使用的群，填平台 group_openid（多个用英文逗号分开），留空不额外限制。
QQ_ALLOWED_GROUPS=
